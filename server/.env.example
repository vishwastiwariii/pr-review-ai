# Server Configuration
PORT=5001
NODE_ENV=development

# CORS Configuration
# Set to a specific origin (e.g. http://localhost:5173) or use * for wildcard in dev
CORS_ORIGIN=http://localhost:5173

# GitHub Classic Auth Fallback (Optional)
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub App Integration Configuration
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_lines_here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# LLM Provider Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ngrok Local Tunnel Configuration
# Set START_NGROK to true to automatically spin up a public tunnel in dev mode
START_NGROK=false
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your_persistent_static_ngrok_subdomain.ngrok-free.dev
