# Server Configuration
PORT=5001
NODE_ENV=development

# CORS Configuration
# Set to a specific origin (e.g. http://localhost:5173) or use * for wildcard in dev
CORS_ORIGIN=http://localhost:5173

# Integrations Configuration (Optional in dev, required in prod)
GITHUB_TOKEN=your_github_personal_access_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Webhook Secret (For validating webhook payloads from GitHub)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
